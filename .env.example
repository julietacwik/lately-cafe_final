# Copiá este archivo como .env y ajustá los valores. No subas .env al repositorio.

# Entorno: development | production
NODE_ENV=development

# Puerto HTTP del servidor (Render lo define automáticamente)
PORT=3000

# Interfaz de red. 0.0.0.0 acepta conexiones externas (necesario en Render).
HOST=0.0.0.0

# URL pública de la aplicación (código QR del menú: PUBLIC_URL/menu).
# En Render, si queda vacía, se usa RENDER_EXTERNAL_URL automáticamente.
PUBLIC_URL=http://localhost:3000

# Ruta del archivo de base de datos SQLite (relativa a la raíz del proyecto o absoluta)
DATABASE_PATH=./data/lately.db

# Carpeta donde se guardan las imágenes subidas (fotos de perfil, productos, clases)
UPLOADS_DIR=./uploads

# Cargar datos de demostración si la base está vacía (true | false).
# Por defecto: true en desarrollo y false en producción. NUNCA true en producción real.
SEED_DEMO=true

# Cookie de sesión solo por HTTPS. Usar true en producción.
COOKIE_SECURE=false

# Duración de la sesión en días
SESSION_DAYS=7

# Poner true si la app corre detrás de un proxy inverso (Render, Railway, Nginx)
TRUST_PROXY=false
